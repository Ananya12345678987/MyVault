# Server
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Database
MONGO_URI=mongodb://localhost:27017/myvault

# Auth (account layer — session/JWT signing, NOT vault encryption)
JWT_SECRET=replace_with_a_64_byte_random_hex_string
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_a_different_64_byte_random_hex_string
JWT_REFRESH_EXPIRES_IN=7d

# Vault
# NOTE: there is intentionally NO "MASTER_ENCRYPTION_KEY" or similar here.
# The vault encryption key is derived per-request from the user's master
# password + their stored per-user salt (see security/vaultCrypto.js).
# A global key in .env would defeat the entire key-hierarchy design and
# is explicitly forbidden by the architecture (see README.md, section 2).

# Auto-lock default (minutes)
DEFAULT_AUTOLOCK_MINUTES=15
